{
  "name": "mila-invest-api-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Suite end-to-end de API de MILA Invest (Playwright Test + Serenity/JS Screenplay + verificación en base de datos)",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:serial": "playwright test --project=api-serial --no-deps",
    "contract:sync": "tsx scripts/sync-contract.ts",
    "contract:check": "tsx scripts/sync-contract.ts --check",
    "report": "html-reporter serve --dir ./reports/serenity-js --open",
    "clean": "rimraf reports playwright-report test-results",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@serenity-js/assertions": "3.49.0",
    "@serenity-js/console-reporter": "3.49.0",
    "@serenity-js/core": "3.49.0",
    "@serenity-js/html-reporter": "3.49.0",
    "@serenity-js/playwright-test": "3.49.0",
    "@serenity-js/rest": "3.49.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "axios": "1.20.0",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.10",
    "eslint": "10.15.0",
    "lossless-json": "4.3.4",
    "pg": "8.23.1",
    "rimraf": "6.1.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "zod": "4.6.7"
  }
}
