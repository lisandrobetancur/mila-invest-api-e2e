# Copiá este archivo a .env para cambiar los valores por defecto.
# La API se levanta con docker compose desde mila-invest-api:
#   DB_HOST_PORT=5433 docker compose up
BASE_URL=http://localhost:8000
# Nunca el 5432: ese PostgreSQL es de la máquina, no de la API.
DATABASE_URL=postgres://mila:mila@localhost:5433/mila
MILA_API_PATH=../mila-invest-api
# WORKERS=4
# Corridas que acumula el reporte de Serenity/JS (1 = solo la última).
# REPORT_HISTORY=5
